# Discovery Desk research UI — local development database.
#
# The Next.js research UI (src/app, src/db, src/lib/research) reads DATABASE_URL
# at runtime and refuses to start without it. This example value is a LOCAL
# DEVELOPMENT FIXTURE, not a secret: it points at a disposable Postgres instance
# on loopback with default dev credentials. Replace it with your own local
# instance; never commit a real database URL or credentials.
#
# drizzle.config.json intentionally carries the same loopback fixture for the
# drizzle-kit CLI (migrations/seed); it is JSON and cannot read env vars.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
